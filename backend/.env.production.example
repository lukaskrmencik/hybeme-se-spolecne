# Production config. Copy to .env.production ON THE SERVER only (it is not in git) and fill in the secrets.
APP_NAME='Hýbeme se společně'
APP_ENV=production
# Generate a new one: docker compose -f compose.prod.yaml run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://hybemesespolecne.cz
APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_PORT=8081

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=hybeme_se_spolecne
DB_USERNAME=hybeme
# A long random password: openssl rand -hex 24
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Real SMTP is needed, registration sends a verification code.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Port 587 upgrades the connection to TLS on its own (STARTTLS). For port 465 use MAIL_SCHEME=smtps.
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS="noreply@hybemesespolecne.cz"
MAIL_FROM_NAME="${APP_NAME}"

# Generate a new one: openssl rand -base64 48   (never reuse the development secret)
JWT_SECRET=
JWT_ALGO=HS256

GOOGLE_CLIENT_IDS=304816017928-ik51lvnmuigf7bed6o0f9vs5jt9m3c5s.apps.googleusercontent.com,304816017928-0grtm8r08u86dclfbrtjf71scditas6d.apps.googleusercontent.com
GOOGLE_WEB_REDIRECT_URL=https://hybemesespolecne.cz/login

# Key the app seals visits with (same value as EXPO_PUBLIC_VISIT_KEY in the frontend). Not in git.
# Generate: openssl rand -base64 32   Empty: visits are sent as plain JSON.
VISIT_PAYLOAD_KEY=
